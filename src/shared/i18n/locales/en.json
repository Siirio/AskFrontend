  "legal.section1.title": "Scope",
  "legal.section2.title": "Your choices and responsibilities",
  "legal.section3.title": "Contact and enforcement",
  "legal.user-terms.title": "Terms of Use",
  "legal.user-terms.section1.body": "These terms govern Ask search, chats, profiles and business tools. By using Ask, you agree to follow applicable law and these rules.",
  "legal.user-terms.section2.body": "Keep your account secure, provide accurate information and do not misuse the service or interfere with other people.",
  "legal.user-terms.section3.body": "Ask may restrict abusive use and will notify users of material changes. Questions can be submitted through support.",
  "legal.privacy.title": "Privacy Policy",
  "legal.privacy.section1.body": "Ask processes account, search, chat, business and technical data needed to provide and secure the service.",
  "legal.privacy.section2.body": "You can review profile data, export your account and request deletion. Access is limited by memberships and permissions.",
  "legal.privacy.section3.body": "Data is retained only for product, security and legal needs. Privacy requests can be made through account settings or support.",
  "legal.seller-terms.title": "Seller Terms",
  "legal.seller-terms.section1.body": "Sellers are responsible for accurate company, contact, delivery and catalog information and lawful order fulfilment.",
  "legal.seller-terms.section2.body": "Products and services must comply with Kazakhstan law, prohibited-products rules and content standards.",
  "legal.seller-terms.section3.body": "Ask may moderate or suspend listings that create legal, safety or trust risks. Appeals are available through support.",
  "legal.import-service.title": "Managed Import Terms",
  "legal.import-service.section1.body": "Managed import lets authorised Ask employees prepare a seller catalog from supplied sources for a limited request.",
  "legal.import-service.section2.body": "The seller remains responsible for source rights and final accuracy. Access ends when the import is completed or revoked.",
  "legal.import-service.section3.body": "Temporary import chats and files are deleted after completion according to the disclosed retention window.",
  "legal.prohibited-products.title": "Prohibited Products Policy",
  "legal.prohibited-products.section1.body": "Illegal, unsafe, counterfeit, exploitative or otherwise prohibited products and services may not be listed.",
  "legal.prohibited-products.section2.body": "Sellers must verify restrictions, licences, age limits and delivery rules before publication.",
  "legal.prohibited-products.section3.body": "Ask may hide or remove listings, suspend a business and report unlawful activity when required.",
  "legal.content-policy.title": "Content Policy",
  "legal.content-policy.section1.body": "Content must be accurate, respectful, relevant and must not violate third-party rights.",
  "legal.content-policy.section2.body": "Spam, harassment, deceptive claims, hate, explicit abuse and malicious files are prohibited.",
  "legal.content-policy.section3.body": "Users can report products, businesses, messages or users. Moderation considers the reason and available evidence.",
  "legal.support.title": "Support",
  "legal.support.section1.body": "Support helps with accounts, business access, invitations, orders, safety reports and managed imports.",
  "legal.support.section2.body": "Include the affected item and a concise description, but never send passwords, access tokens or unnecessary personal data.",
  "legal.support.section3.body": "Use the support conversation available in Ask. Urgent safety or legal matters are prioritised.",
  "legal.account-deletion.title": "Account Deletion",
  "legal.account-deletion.section1.body": "You can export your account before requesting permanent deletion from the privacy and account section.",
  "legal.account-deletion.section2.body": "A sole business owner must transfer ownership or choose to delete the business before deleting the account.",
  "legal.account-deletion.section3.body": "Deletion revokes sessions, removes memberships and temporary data, anonymises records and retains only legally required information."
